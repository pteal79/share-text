{
    "name": "pteal79/share-text",
    "description": "NativePHP Mobile v4 plugin that opens the native share sheet with plain text",
    "type": "nativephp-plugin",
    "license": "MIT",
    "keywords": [
        "nativephp",
        "mobile",
        "share",
        "text",
        "laravel"
    ],
    "require": {
        "php": "^8.4",
        "nativephp/mobile": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Pteal79\\ShareText\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pteal79\\ShareText\\ShareTextServiceProvider"
            ],
            "aliases": {
                "ShareText": "Pteal79\\ShareText\\Facades\\ShareText"
            }
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
